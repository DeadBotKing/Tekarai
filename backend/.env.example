# ============================================================================
# Tekarai Backend — Environment Template (Phase 01 · docs/Phases/Phase1.md §6)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in local values:   copy .env.example .env
# The real `.env` is ignored by Git — never commit real credentials.
#
# Naming (ADR-001 / ADR-011):
#   - Framework-level names stay UPPER_SNAKE_CASE (SECRET_KEY, ALLOWED_HOSTS).
#   - Project-specific names are camelCase (dbHost, jwtSigningKey, ...).
# ============================================================================

# ------------------------------------------------------------ APPLICATION ---
environment=development
# appName is informational until the product phase requires it.
appName=Tekarai
timeZone=UTC
languageCode=en-us

# --------------------------------------------------- DJANGO / SECURITY ------
# Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development an empty value makes Django generate an ephemeral key.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- DATABASE ---
# System of record: mssql (ADR-004). Offline development/testing: sqlite.
dbEngine=mssql
dbHost=localhost
dbPort=1433
dbName=TekaraiCore
dbUser=tekarai
dbPassword=CHANGE-ME-USE-SECRET-MANAGER
dbConnTimeout=30
dbConnMaxAge=60
dbEncrypt=true
odbcDriver=ODBC Driver 18 for SQL Server

# -------------------------------------------------------------------- CORS ---
# Comma-separated allow-list. Never use "*" in production.
corsAllowedOrigins=http://localhost:3000,http://127.0.0.1:3000
csrfTrustedOrigins=http://localhost:3000

# ----------------------------------------------------------------- LOGGING ---
logLevel=INFO
logFormat=console

# ------------------------------------------------------------------- CACHE ---
# Reserved — cache infrastructure arrives in a later phase (Redis).
# cacheUrl=redis://localhost:6379/0

# -------------------------------------------------------------------- EMAIL ---
# Reserved — notification/email phase configures delivery.
emailBackend=django.core.mail.backends.console.EmailBackend
emailHost=smtp.example.com
emailPort=587
emailHostUser=
emailHostPassword=
defaultFromEmail=no-reply@example.com

# ----------------------------------------------------------------- STORAGE ---
# Reserved — binary storage abstraction arrives with the Documents phase.
storageBackend=local
staticRoot=staticRoot
mediaRoot=mediaRoot

# ---------------------------------------------------------------------- JWT ---
# Reserved for the Identity phase (SimpleJWT). No JWT code exists in Phase 01.
# Phase 07 §7/§8 (ADR-022): dedicated HMAC key for access-token signing.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Empty value falls back to SECRET_KEY (acceptable in development only).
jwtSigningKey=
jwtIssuer=tekarai
jwtAudience=tekarai-api
jwtAccessTtlMinutes=15
jwtChallengeTtlMinutes=5
jwtAccessTokenLifetimeMinutes=15
jwtRefreshTokenLifetimeDays=7

# ------------------------------------------------------ EXTERNAL SERVICES ---
# Reserved — the Integration Hub phase defines adapter endpoints.
externalServicesEnabled=false

# -------------------------------------------------------- AI PROVIDERS ------
# Phase 13-L provider adapters (docs/Phases/Phase13/Phase13-L.md).
# Secrets live ONLY in the environment/secret manager — never in source.
# An adapter is instantiated only when its configuration is complete;
# leave credentials empty to keep a provider disabled.
aiProviderTimeoutSeconds=30
aiProviderOpenAiBaseUrl=https://api.openai.com/v1
aiProviderOpenAiApiKey=
aiProviderAzureOpenAiBaseUrl=
aiProviderAzureOpenAiApiKey=
aiProviderAzureOpenAiApiVersion=2024-10-21
aiProviderOllamaBaseUrl=http://127.0.0.1:11434
aiProviderOllamaApiKey=
aiProviderAnthropicBaseUrl=https://api.anthropic.com
aiProviderAnthropicApiKey=
aiProviderAnthropicVersion=2023-06-01
aiProviderLocalBaseUrl=
aiProviderLocalApiKey=
aiProviderLocalSupportsEmbedding=false

# ------------------------------------------------------ AI USAGE (13-N) -----
# Phase 13-N usage/token/latency/cost/quota metering
# (docs/Phases/Phase13/Phase13-N.md). Zero token/cost limit = unlimited;
# explicit per-tenant quota policies always win over these defaults.
aiUsageEnabled=true
aiUsageDefaultTokenLimit=0
aiUsageDefaultCostLimit=0
aiUsageDefaultCurrency=USD
aiUsageRetentionDays=90

# ------------------------------------------------- AI AUDIT & GOV (13-O) ----
# Phase 13-O audit trail and governance
# (docs/Phases/Phase13/Phase13-O.md). Zero budget = unlimited; explicit
# per-tenant governance policies always win over these defaults.
aiAuditEnabled=true
aiAuditRetentionDays=365
aiAuditIncludeRestrictedDetail=false
aiGovernanceEnabled=true
aiGovernanceDefaultMaxCostPerDay=0
aiGovernanceDefaultCurrency=USD
aiQueueEnabled=true
aiQueueRetentionDays=30
aiQueueDefaultMaxAttempts=3
aiQueueClaimLimit=10
aiWorkerId=aiWorker
aiWorkerLeaseSeconds=120
aiWorkerRetryBaseSeconds=30
aiWorkerRetryMultiplier=2.0
aiWorkerRetryMaxSeconds=600
aiWorkerIdleSleepSeconds=5

# ---------------------------------------------------------------------------
# Phase 13-M retry / fallback / timeout budget (restored by Phase 13-Q)
# ---------------------------------------------------------------------------
# Total attempts for one provider step (1 disables retry).
aiRetryMaxAttempts=3
# Initial backoff before the first retry, in seconds.
aiRetryInitialBackoffSeconds=0.25
# Geometric growth factor applied to the backoff after each retry.
aiRetryBackoffMultiplier=2.0
# Ceiling for a single backoff wait, in seconds.
aiRetryMaxBackoffSeconds=5.0
# Wall-clock budget for the whole call including fallbacks, in seconds.
aiProviderTimeoutBudgetSeconds=60
# Ordered fallback chain: primary first, then secondaries, then local.
# Comma-separated provider codes; empty disables fallback.
# Example: aiProviderFallbackChain=OPENAI,ANTHROPIC,LOCAL
aiProviderFallbackChain=

# ---------------------------------------------------------------------------
# Phase 13-Q embedding foundation
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses embedding writes and reads.
aiEmbeddingEnabled=true
# Maximum texts sent to a provider in one batch call (absolute ceiling 512).
aiEmbeddingMaxBatchSize=32
# Maximum estimated tokens accepted for a single embeddable text.
aiEmbeddingMaxInputTokens=8192
# Default comparison metric for new vector spaces: COSINE, DOT_PRODUCT, EUCLIDEAN.
aiEmbeddingDefaultMetric=COSINE
# Default stored-vector normalization for new spaces: L2 or NONE.
aiEmbeddingDefaultNormalization=L2
# Reuse a stored vector when the same text is embedded again in the same space.
aiEmbeddingCacheEnabled=true
# Maximum rows scanned by the brute-force similarity search.
aiEmbeddingSearchCandidateLimit=1000
# Retention horizon for stored vectors, in days.
aiEmbeddingRetentionDays=365

# ---------------------------------------------------------------------------
# Phase 13-R knowledge ingestion, chunking, indexing
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses ingestion and knowledge reads.
aiKnowledgeEnabled=true
# Default split strategy: PARAGRAPH, SENTENCE, or FIXED_TOKEN.
aiKnowledgeChunkStrategy=PARAGRAPH
# Token budget of a single chunk (absolute ceiling 4096).
aiKnowledgeChunkTokens=512
# Tokens repeated between consecutive chunks; must be below the budget.
aiKnowledgeChunkOverlapTokens=64
# A trailing chunk smaller than this merges into its predecessor when it fits.
aiKnowledgeMinChunkTokens=32
# Embed newly created chunks through the Phase 13-Q foundation automatically.
aiKnowledgeAutoEmbed=true
# Chunks sent per embedding call.
aiKnowledgeEmbedBatchSize=32
# Maximum chunks a single source may produce (absolute ceiling 2000).
aiKnowledgeMaxChunksPerSource=500
# Retention horizon for archived knowledge sources, in days.
aiKnowledgeRetentionDays=730

# ---------------------------------------------------------------------------
# Phase 13-S retrieval, RAG, reranking
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses retrieval and grounded answers.
aiRetrievalEnabled=true
# Candidate strategy: VECTOR, LEXICAL, or HYBRID (rank fusion of both).
aiRetrievalStrategy=HYBRID
# Evidence blocks returned after reranking.
aiRetrievalTopK=5
# Maximum candidates considered before authorization (ceiling 5000).
aiRetrievalCandidateLimit=200
# Minimum final score for an evidence block; empty means no floor.
aiRetrievalMinScore=
# Rerank strategy: NONE, LEXICAL_BOOST, or MMR (diversity).
aiRetrievalRerank=LEXICAL_BOOST
# Weight of query-token coverage when blending with the retrieval score.
aiRetrievalLexicalWeight=0.3
# MMR trade-off: 1.0 is pure relevance, 0.0 is pure diversity.
aiRetrievalMmrLambda=0.7
# Token budget of the assembled context.
aiRetrievalMaxContextTokens=4000
# Maximum evidence blocks placed in one context.
aiRetrievalMaxContextSources=10
# Maximum chunks scanned by the keyword pass.
aiRetrievalLexicalScanLimit=500
# Refuse to answer when no authorized evidence survives filtering.
aiRagRequireGrounding=true
# Model code used for the grounded answer; empty falls back to the request.
aiRagAnswerModel=

# ---------------------------------------------------------------------------
# Phase 13-T AI memory (closes Open Question #8: ceilings and retention)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses memory reads and writes.
aiMemoryEnabled=true
# Maximum active entries per scope; the overflow is evicted.
aiMemoryMaxEntriesPerScope=200
# Default time-to-live applied when a scope defines none; 0 means no expiry.
aiMemoryDefaultTtlSeconds=0
# Maximum canonical value size of one entry, in bytes (absolute ceiling 262144).
aiMemoryMaxValueBytes=32768
# Eviction strategy when a scope is full: OLDEST_FIRST, LOWEST_PRIORITY, NONE.
aiMemoryEviction=OLDEST_FIRST
# Maximum memory blocks placed in one prompt context.
aiMemoryContextMaxEntries=10
# Token budget for memory blocks inside a context.
aiMemoryContextMaxTokens=1000
# Retention horizon for superseded/forgotten versions, in days.
aiMemoryRetentionDays=365
# Apply the per-scope platform defaults (short-term expires fast, long-term persists).
aiMemoryUseScopeDefaults=true

# ---------------------------------------------------------------------------
# Phase 13-U evaluation (closes Open Question #9: method and acceptance bar)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses evaluation runs and reads.
aiEvaluationEnabled=true
# Minimum weighted score a run must reach to avoid a FAIL verdict.
aiEvaluationMinOverallScore=0.7
# How many failing cases a run may contain before it fails outright.
aiEvaluationMaxFailedCases=0
# Warn ratio above which a run is downgraded to WARN.
aiEvaluationMaxWarnRatio=0.3
# Score drop against the baseline run that counts as a regression.
aiEvaluationRegressionTolerance=0.02
# Groundedness bands: below fail is FAIL, below warn is WARN.
aiEvaluationGroundednessFailBelow=0.5
aiEvaluationGroundednessWarnBelow=0.75
# Maximum cases executed in one run (absolute ceiling 1000).
aiEvaluationMaxCasesPerRun=200
# Retention horizon for settled runs, in days.
aiEvaluationRetentionDays=365
# Comma-separated terms that must never appear in an answer.
# Example: aiEvaluationForbiddenTerms=password,api key
aiEvaluationForbiddenTerms=

# ---------------------------------------------------------------------------
# Phase 13-V feedback (closes the loop: complaint → golden case → evaluation)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses feedback submission and reads.
aiFeedbackEnabled=true
# How many times the same problem must be reported before it becomes a case.
aiFeedbackPromotionThreshold=2
# Require a correction (what the right answer looks like) before promoting.
aiFeedbackRequireCorrection=true
# Require a reason from the closed vocabulary before promoting.
aiFeedbackRequireReason=true
# Ratings at or below this value count as negative.
aiFeedbackNegativeRatingCeiling=2
# Satisfaction below which a feedback window is considered unhealthy.
aiFeedbackMinSatisfaction=0.6
# Movement beyond this delta counts as a satisfaction trend change.
aiFeedbackTrendTolerance=0.05
# Length of one trend window, in days.
aiFeedbackTrendWindowDays=7
# Promote qualifying complaints automatically during the sweep.
aiFeedbackAutoPromote=false
# Suite that collects cases born from complaints.
aiFeedbackGoldenSuite=FEEDBACK_GOLDEN
# Retention horizon for settled (promoted/rejected) signals, in days.
aiFeedbackRetentionDays=730

# ---------------------------------------------------------------------------
# Phase 13-W observability and alerting (§34 metrics → monitoring platform)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses metric collection and exposition.
aiObservabilityEnabled=true
# Default collection window, in minutes.
aiObservabilityWindowMinutes=60
# Widest window a single collection may cover, in hours.
aiObservabilityMaxWindowHours=24
# Retention horizons for frozen snapshots and settled alerts, in days.
aiObservabilitySnapshotRetentionDays=90
aiObservabilityAlertRetentionDays=365
# Evaluate alert rules after every collection.
aiAlertingEnabled=true
# Alert thresholds: failed attempt ratio, p95 latency, queue backlog,
# human satisfaction floor, and evaluation score floor.
aiAlertErrorRatio=0.1
aiAlertLatencyP95Ms=15000
aiAlertQueueDepth=100
aiAlertFeedbackScore=0.5
aiAlertEvaluationScore=0.6

# ---------------------------------------------------------------------------
# Phase 13-X tool registry and execution (§30; closes Open Question #10)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses tool registration and execution.
aiToolEnabled=true
# Risk level at or above which a human must approve each call.
aiToolAutomaticBelowRisk=HIGH
# Risk level at or above which two distinct humans must approve.
aiToolDualControlAtRisk=CRITICAL
# Tool calls allowed inside one AI request, and how often the same call
# may repeat before it is treated as a loop.
aiToolMaxCallsPerRequest=10
aiToolMaxRepeatsPerRequest=2
# Execution timeout and maximum argument payload for one call.
aiToolTimeoutSeconds=30
aiToolMaxArgumentBytes=16384
# How long a granted approval stays usable, in seconds.
aiToolApprovalTtlSeconds=3600
# Retention horizon for settled invocations, in days.
aiToolRetentionDays=365

# ---------------------------------------------------------------------------
# Phase 13-Y agent foundation (§31; closes Open Question #11)
# ---------------------------------------------------------------------------
# Fail-closed switch: false refuses agent registration and execution.
aiAgentEnabled=true
# Risk level at or above which a human must approve a run before it starts.
aiAgentAutomaticBelowRisk=HIGH
# Risk level at or above which two distinct humans must approve a run.
aiAgentDualControlAtRisk=CRITICAL
# Model calls (steps) and tool calls allowed inside one run, and how often
# the same tool call may repeat across steps before it is treated as a loop.
aiAgentMaxStepsPerRun=10
aiAgentMaxToolCallsPerRun=20
aiAgentMaxRepeatsPerRun=2
# Wall-clock ceiling for one run, in seconds.
aiAgentMaxDurationSeconds=120
# Token ceiling for the assembled run context, and byte ceilings for the
# versioned instructions and one run input.
aiAgentMaxContextTokens=16000
aiAgentMaxInstructionsBytes=16384
aiAgentMaxInputBytes=65536
# How long a granted run approval stays usable, in seconds.
aiAgentApprovalTtlSeconds=3600
# Retention horizon for settled runs and their steps, in days.
aiAgentRetentionDays=365

# Phase 13-Z public agent API and release runtime. Keep the deterministic
# provider disabled outside explicit offline/test environments.
aiAgentDefaultProvider=
aiAgentDefaultModel=
aiAgentAllowDeterministicProvider=false

# Phase 14 — Communication security and retention
communicationMaxAttachmentBytes=26214400
communicationAllowedAttachmentTypes=application/pdf,image/jpeg,image/png,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
communicationRequireCleanScan=true
communicationRetentionDays=2555

# Phase 15 — Notification Platform
notificationRetentionDays=365
notificationWebhookToleranceSeconds=300
notificationCeleryBrokerUrl=redis://127.0.0.1:6379/2
notificationCeleryResultBackend=redis://127.0.0.1:6379/3
# Provider callback secrets must be injected via secret manager integration.

# Phase 16 — Self-Learning Platform
# Learning jobs use the same broker with isolated learning.training and
# learning.monitoring queues. Replace deterministic engines through settings
# provider paths when governed production engines are available.
# Durable artifact storage defaults to backend/var/learningArtifacts in local use.
