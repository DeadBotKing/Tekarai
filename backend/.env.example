# ============================================================================
# Tekarai Backend — Environment Template (Phase 01 · docs/Phases/Phase1.md §6)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in local values:   copy .env.example .env
# The real `.env` is ignored by Git — never commit real credentials.
#
# Naming (ADR-001 / ADR-011):
#   - Framework-level names stay UPPER_SNAKE_CASE (SECRET_KEY, ALLOWED_HOSTS).
#   - Project-specific names are camelCase (dbHost, jwtSigningKey, ...).
# ============================================================================

# ------------------------------------------------------------ APPLICATION ---
environment=development
# appName is informational until the product phase requires it.
appName=Tekarai
timeZone=UTC
languageCode=en-us

# --------------------------------------------------- DJANGO / SECURITY ------
# Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In development an empty value makes Django generate an ephemeral key.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------- DATABASE ---
# System of record: mssql (ADR-004). Offline development/testing: sqlite.
dbEngine=mssql
dbHost=localhost
dbPort=1433
dbName=TekaraiCore
dbUser=tekarai
dbPassword=CHANGE-ME-USE-SECRET-MANAGER
dbConnTimeout=30
dbConnMaxAge=60
dbEncrypt=true
odbcDriver=ODBC Driver 18 for SQL Server

# -------------------------------------------------------------------- CORS ---
# Comma-separated allow-list. Never use "*" in production.
corsAllowedOrigins=http://localhost:3000,http://127.0.0.1:3000
csrfTrustedOrigins=http://localhost:3000

# ----------------------------------------------------------------- LOGGING ---
logLevel=INFO
logFormat=console

# ------------------------------------------------------------------- CACHE ---
# Reserved — cache infrastructure arrives in a later phase (Redis).
# cacheUrl=redis://localhost:6379/0

# -------------------------------------------------------------------- EMAIL ---
# Reserved — notification/email phase configures delivery.
emailBackend=django.core.mail.backends.console.EmailBackend
emailHost=smtp.example.com
emailPort=587
emailHostUser=
emailHostPassword=
defaultFromEmail=no-reply@example.com

# ----------------------------------------------------------------- STORAGE ---
# Reserved — binary storage abstraction arrives with the Documents phase.
storageBackend=local
staticRoot=staticRoot
mediaRoot=mediaRoot

# ---------------------------------------------------------------------- JWT ---
# Reserved for the Identity phase (SimpleJWT). No JWT code exists in Phase 01.
# Phase 07 §7/§8 (ADR-022): dedicated HMAC key for access-token signing.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Empty value falls back to SECRET_KEY (acceptable in development only).
jwtSigningKey=
jwtIssuer=tekarai
jwtAudience=tekarai-api
jwtAccessTtlMinutes=15
jwtChallengeTtlMinutes=5
jwtAccessTokenLifetimeMinutes=15
jwtRefreshTokenLifetimeDays=7

# ------------------------------------------------------ EXTERNAL SERVICES ---
# Reserved — the Integration Hub phase defines adapter endpoints.
externalServicesEnabled=false

# -------------------------------------------------------- AI PROVIDERS ------
# Phase 13-L provider adapters (docs/Phases/Phase13/Phase13-L.md).
# Secrets live ONLY in the environment/secret manager — never in source.
# An adapter is instantiated only when its configuration is complete;
# leave credentials empty to keep a provider disabled.
aiProviderTimeoutSeconds=30
aiProviderOpenAiBaseUrl=https://api.openai.com/v1
aiProviderOpenAiApiKey=
aiProviderAzureOpenAiBaseUrl=
aiProviderAzureOpenAiApiKey=
aiProviderAzureOpenAiApiVersion=2024-10-21
aiProviderOllamaBaseUrl=http://127.0.0.1:11434
aiProviderOllamaApiKey=
aiProviderAnthropicBaseUrl=https://api.anthropic.com
aiProviderAnthropicApiKey=
aiProviderAnthropicVersion=2023-06-01
aiProviderLocalBaseUrl=
aiProviderLocalApiKey=
aiProviderLocalSupportsEmbedding=false

# -------------------------------------------------------- AI RESILIENCE -----
# Phase 13-M retry / fallback / timeout budget
# (docs/Phases/Phase13/Phase13-M.md, Master Specification §25 §42 §44).
# Max attempts per provider step in a resilient chain (>= 1).
aiRetryMaxAttempts=3
# Initial backoff before the first retry, in seconds.
aiRetryInitialBackoffSeconds=0.25
# Geometric growth factor applied to the backoff after each retry.
aiRetryBackoffMultiplier=2.0
# Hard cap on any single backoff delay, in seconds.
aiRetryMaxBackoffSeconds=5.0
# Wall-clock budget for one resilient AI operation, in seconds (> 0).
aiProviderTimeoutBudgetSeconds=60
# Ordered fallback chain: primary first, then secondaries, then local.
# Comma-separated provider codes; empty disables fallback.
# Example: aiProviderFallbackChain=OPENAI,ANTHROPIC,LOCAL
aiProviderFallbackChain=
