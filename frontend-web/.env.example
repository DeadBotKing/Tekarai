# API requests use relative paths by default so the browser never calls localhost.
# Set this only when the deployed frontend and API have different origins.
VITE_API_BASE_URL=
VITE_API_VERSION=v1
# Demo mode serves fabricated fixtures and a login that accepts ANY password.
# It is honoured in development builds only. A production build ignores this
# flag and logs an error, unless VITE_ALLOW_DEMO_IN_PRODUCTION is also true.
VITE_DEMO_MODE=true
# Escape hatch for a deliberately public sales demo. Never set this on a
# deployment that holds real tenant data.
VITE_ALLOW_DEMO_IN_PRODUCTION=false
VITE_APP_NAME=Tekarai
VITE_REALTIME_ENABLED=false
