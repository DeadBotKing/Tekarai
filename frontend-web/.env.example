# API requests use relative paths by default so the browser never calls localhost.
# Set this only when the deployed frontend and API have different origins.
VITE_API_BASE_URL=
VITE_API_VERSION=v1
# Demo mode is enabled for local UI previews. Set false in an authenticated deployment.
VITE_DEMO_MODE=true
VITE_APP_NAME=Tekarai
VITE_REALTIME_ENABLED=false
